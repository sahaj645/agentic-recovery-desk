# Model responses are cached locally; runs must not depend on them being present.
.cache/

# Run artefacts are regenerated by `python run.py demo` in ~2s; only the
# versioned results table is committed.
results/reports/

# Generated by `python run.py ui` -- deterministic from the seed, regenerated
# on demand, not committed (same convention as results/reports/).
web/data/

# Personal local-run scripts, if anyone makes one to hold an API key while
# testing locally. Never commit a key -- even one deleted in a later commit
# stays in git history forever unless it's rewritten.
run_local.ps1
run_local.sh
.env
